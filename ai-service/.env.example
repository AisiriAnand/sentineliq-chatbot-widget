# AI Service Environment Configuration
# Copy this file to .env and fill in your actual values

# Required: Groq API Key (get from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Service Configuration
AI_PORT=5000
FLASK_DEBUG=false

# Optional: Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379/0

# Optional: Embedding Model (sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional: ChromaDB Path (for vector database)
CHROMA_DB_PATH=./chroma_db

# Optional: CORS Allowed Origin
ALLOWED_ORIGIN=*
